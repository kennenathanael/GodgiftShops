# PostgreSQL connection string (get this from Vercel Postgres or Neon)
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Secret used to sign admin/customer login cookies (any long random string)
AUTH_SECRET="change-this-to-a-long-random-string"

# Vercel Blob token for image uploads (get this from Vercel Storage tab)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Your site's public URL (used in a few links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
